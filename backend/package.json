{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env.local --watch src/node-server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=../.env.local src/node-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "db:indexes": "node --env-file-if-exists=../.env.local src/scripts/ensure-indexes.ts",
    "keys:generate": "node src/scripts/generate-jwt-keypair.ts",
    "db:seed-demo": "node --env-file-if-exists=../.env.local src/scripts/seed-demo-user.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@wealth-advisor/contracts": "*",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^5.9.3"
  },
  "imports": {
    "#core/*": "./src/core/*",
    "#modules/*": "./src/modules/*"
  }
}
